# Local LiteLLM gateway authentication (must start with sk-)
LITELLM_MASTER_KEY=sk-local-master-key

# Set the provider key matching the model route you use.
RELAY_OPENAI_API_KEY=sk-ant-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Skyvern Cloud or self-hosted API credentials
SKYVERN_API_KEY=your-skyvern-api-key

