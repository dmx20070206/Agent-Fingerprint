diff --git a/skyvern/webeye/scraper/scraper.py b/skyvern/webeye/scraper/scraper.py
index 27528aeb0..6eef2d173 100644
--- a/skyvern/webeye/scraper/scraper.py
+++ b/skyvern/webeye/scraper/scraper.py
@@ -925,6 +925,32 @@ async def get_interactable_element_tree(
     # element tree only — never ``elements`` — so they can never become a click target.
     element_tree.extend(placeholder_nodes)
 
+    # Mouse-trajectory pages expose passive waypoint nodes through ``data-step``.
+    # They are visible in the rendered tree but, because they are non-interactive
+    # divs, Skyvern normally omits them from the id maps and cannot execute the
+    # HOVER actions it plans for them. Promote only these explicitly marked
+    # waypoints into the resolvable map; this does not broaden ordinary static
+    # text into click/type targets, and hover still uses real Playwright input.
+    known_element_ids = {str(element.get("id")) for element in elements if element.get("id") is not None}
+
+    def promote_waypoints(nodes: list[dict]) -> None:
+        for node in nodes:
+            attributes = node.get("attributes") or {}
+            element_id = node.get("id")
+            if attributes.get("data-step") is not None and element_id is not None:
+                normalized_id = str(element_id)
+                if normalized_id not in known_element_ids:
+                    # ``trim_element_tree`` preserves ids for hover-only nodes,
+                    # so the planner can reference the same id we promote here.
+                    node["hoverOnly"] = True
+                    elements.append(node)
+                    known_element_ids.add(normalized_id)
+            children = node.get("children") or []
+            if children:
+                promote_waypoints(children)
+
+    promote_waypoints(element_tree)
+
     return elements, element_tree, destinations
 
 
