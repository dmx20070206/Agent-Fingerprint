+        # The rendered element tree intentionally includes useful static nodes
+        # (for example hover waypoints), while ScrapedPage's flat interaction
+        # map contains only click/type controls. The model can therefore emit a
+        # valid hover target that is present in the live DOM but absent from the
+        # map. Resolve that exact Skyvern id directly for hover only; the normal
+        # mapped path remains authoritative for every other action type.
+        fallback_locator = page.locator(f'[{SKYVERN_ID_ATTR}="{action.element_id}"]')
+        if await fallback_locator.count() != 1:
+            LOG.warning(
+                "Failed to resolve element for hover action",
+                action=action,
+                workflow_run_id=task.workflow_run_id,
+                exc_info=True,
+            )
+            return [ActionFailure(exception=exc)]
+        try:
+            await fallback_locator.scroll_into_view_if_needed(timeout=settings.BROWSER_ACTION_TIMEOUT_MS)
+            await EventStrategyFactory.move_to_element(page, fallback_locator)
+            await fallback_locator.hover(timeout=settings.BROWSER_ACTION_TIMEOUT_MS)
+            if action.hold_seconds and action.hold_seconds > 0:
+                await asyncio.sleep(action.hold_seconds)
+            return [ActionSuccess()]
+        except Exception as fallback_exc:
