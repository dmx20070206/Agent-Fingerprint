+"""Native select observations and recovery from actions that make no progress."""
+
+import json
+
+from selenium.webdriver.common.keys import Keys
+from selenium.webdriver.common.action_chains import ActionChains
+from selenium.webdriver.support.ui import Select
+
+
+def describe_select(driver, element):
+    state = driver.execute_script("""
+        const e = arguments[0];
+        return {
+            label: e.getAttribute('aria-label') ||
+                Array.from(e.labels || []).map(x => x.textContent.trim()).join(' ') || e.name || e.id,
+            value: e.value,
+            selected: Array.from(e.selectedOptions).map(o => ({text: o.text, value: o.value})),
+            options: Array.from(e.options).map(o => ({text: o.text, value: o.value,
+                disabled: o.disabled || !!(o.parentElement && o.parentElement.disabled)}))
+        };
+    """, element)
+    return json.dumps(state, ensure_ascii=False)
+
+
+def select_option(driver, element, content):
+    if element.tag_name.lower() != 'select':
+        raise ValueError('Select requires a native <select>; use Click for custom menus.')
+    control = Select(element)
+    # Prefer exact visible text, then exact value. Never silently choose a partial match.
+    matches = [o for o in control.options if o.text.strip() == content.strip()]
+    if not matches:
+        matches = [o for o in control.options if o.get_attribute('value') == content]
+    if len(matches) != 1 or not matches[0].is_enabled():
+        raise ValueError('Option is missing, ambiguous, or disabled. Available state: ' +
+                         describe_select(driver, element))
+    option = matches[0]
+    if control.is_multiple:
+        raise ValueError('Select currently supports single-choice dropdowns only.')
+    # Selenium clicks the native option and emits the native change event when its value changes.
+    if not option.is_selected():
+        option.click()
+    if not option.is_selected():
+        raise ValueError('Selection did not take effect: ' + describe_select(driver, element))
+    return 'Dropdown selection verified: ' + describe_select(driver, element)
+
+
+def page_state(driver):
+    """Capture observable state, excluding focus and transient screenshot labels."""
+    return driver.execute_script("""
+        return JSON.stringify({url: location.href, text: document.body.innerText,
+            status: document.body.dataset.taskStatus,
+            scroll: [window.scrollX, window.scrollY],
+            fields: Array.from(document.querySelectorAll('input, textarea, select')).map(e =>
+                [e.tagName, e.id, e.name, e.value, e.checked,
+                 e.tagName === 'SELECT' ? Array.from(e.selectedOptions).map(o => o.index) : null]),
+            scrolls: Array.from(document.querySelectorAll('*')).filter(e =>
+                e.scrollTop || e.scrollLeft).map(e => [e.id, e.scrollTop, e.scrollLeft])});
+    """)
+
+
+class NoProgressGuard:
+    def __init__(self):
+        self.state = None
+        self.attempts = set()
+        self.last_signature = None
+
+    def blocked(self, signature, state):
+        if state != self.state:
+            self.attempts.clear()
+            self.state = state
+        # Hover tasks can require A -> B -> A without visible page changes.
+        if signature[0] == 'move':
+            return signature == self.last_signature and signature in self.attempts
+        return signature in self.attempts
+
+    def record(self, signature, before, after):
+        if before != after:
+            self.attempts.clear()
+        else:
+            self.attempts.add(signature)
+        self.state = after
+        self.last_signature = signature
+
+
+def recover_no_progress(driver):
+    # Dismiss an open native popup without reloading or losing completed form fields.
+    ActionChains(driver).send_keys(Keys.ESCAPE).perform()
+    return ('Recovery: the repeated action was skipped because page text, form values, '
+            'URL and scroll position did not change. Open menus were dismissed; inspect '
+            'the fresh observation and choose a different action. For <select>, use '
+            'Select [Numerical_Label]; [exact option text or value], and check its selected value.')
