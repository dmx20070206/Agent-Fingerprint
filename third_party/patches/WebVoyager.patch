+def _safe_quit_driver(driver):
+    try:
+        driver.quit()
+    except Exception:
+        logging.exception("Unable to quit Selenium driver")
+    finally:
+        try:
+            _ACTIVE_DRIVERS.remove(driver)
+        except ValueError:
