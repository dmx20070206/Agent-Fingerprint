+def wait_for_page_ready(driver, minimum_wait=5):
+    """Wait for normal page load and the optional fingerprint interaction gate.
+
+    Upstream WebVoyager waits five seconds after navigation.  Instrumented
+    Agent-Fingerprint pages can intentionally hold interaction for longer, so
+    also honor the readiness timestamp exposed by the injected monitor.  The
+    timestamp is absent on ordinary external pages.
+    """
+
+    time.sleep(minimum_wait)
+    try:
+        remaining_ms = driver.execute_script(
+            "return Math.max(0, (window.__AGENT_FINGERPRINT_READY_AT__ || 0) - Date.now());"
+        )
+        if remaining_ms:
+            time.sleep(float(remaining_ms) / 1000 + 0.25)
+    except Exception:
+        # Monitoring is optional and must never prevent regular WebVoyager
+        # pages from loading.
+        pass
+
