+def create_driver(options):
+    """Create Chrome with an optional explicitly managed driver binary."""
+
+    driver_binary = os.environ.get("WEBVOYAGER_CHROMEDRIVER") or os.environ.get("CHROMEDRIVER")
+    if driver_binary:
